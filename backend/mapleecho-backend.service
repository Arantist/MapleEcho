[Unit]
Description=MapleEcho FastAPI backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/mapleecho-backend/backend
Environment=PYTHONUNBUFFERED=1
Environment=CORS_ORIGINS=http://localhost:3000,https://fengye-rain.life,https://www.fengye-rain.life
ExecStart=/opt/mapleecho-backend/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
